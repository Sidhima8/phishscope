# ==============================================================================
# PhishScope Environment Configuration Template
# Copy this file to .env and adjust variables as required.
# ==============================================================================

# Application Settings
PROJECT_NAME="PhishScope"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security (Generate a strong 32+ character secret in production)
SECRET_KEY="replace-with-a-secure-random-secret-key-for-jwt-signing"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection
# SQLite (zero configuration, works out of the box locally):
DATABASE_URL="sqlite+aiosqlite:///./phishscope.db"
# PostgreSQL (production Docker Compose):
# DATABASE_URL="postgresql+asyncpg://phishscope:phishscope_secure_pass@localhost:5432/phishscope_db"

# External Threat Intelligence APIs (Optional - platform functions with local engines if omitted)
# VirusTotal API v3 Key:
VIRUSTOTAL_API_KEY=""

# URLhaus API Key (Optional - community access is enabled by default):
URLHAUS_API_KEY=""

# Optional LLM Analysis Engine (Gemini / OpenAI API Key for executive narrative synthesis):
GEMINI_API_KEY=""

# Operational Limits
MAX_UPLOAD_SIZE_MB=25
SSRF_TIMEOUT_SECONDS=4.0
MAX_REDIRECT_HOPS=5
